{
  "name": "goqulient",
  "displayName": "GoQulient",
  "description": "Browse PostgreSQL, MySQL/MariaDB and MongoDB databases and their ER diagrams, like the Goku app.",
  "version": "0.1.0",
  "publisher": "yuji-luigi",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuji-luigi/goqulient.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/yuji-luigi/goqulient/issues"
  },
  "homepage": "https://github.com/yuji-luigi/goqulient#readme",
  "type": "module",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Connections from workspace settings and .env files are only read in trusted workspaces.",
      "restrictedConfigurations": [
        "goqulient.connections",
        "goqulient.envFiles",
        "goqulient.envConnections"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "goqulient.engineInfo",
        "title": "Show Engine Version",
        "category": "GoQulient"
      },
      {
        "command": "goqulient.restartEngine",
        "title": "Restart Engine",
        "category": "GoQulient"
      },
      {
        "command": "goqulient.showLog",
        "title": "Show Log",
        "category": "GoQulient"
      },
      {
        "command": "goqulient.addConnection",
        "title": "Add Connection",
        "category": "GoQulient",
        "icon": "$(add)"
      },
      {
        "command": "goqulient.forgetPassword",
        "title": "Forget Saved Password",
        "category": "GoQulient"
      },
      {
        "command": "goqulient.openSettings",
        "title": "Open Settings",
        "category": "GoQulient",
        "icon": "$(gear)"
      },
      {
        "command": "goqulient.refresh",
        "title": "Refresh Connections",
        "category": "GoQulient",
        "icon": "$(refresh)"
      },
      {
        "command": "goqulient.refreshNode",
        "title": "Refresh",
        "category": "GoQulient",
        "icon": "$(refresh)"
      },
      {
        "command": "goqulient.retry",
        "title": "Retry",
        "category": "GoQulient",
        "icon": "$(debug-restart)"
      },
      {
        "command": "goqulient.disconnect",
        "title": "Disconnect",
        "category": "GoQulient",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "goqulient.cancelConnecting",
        "title": "Cancel Connecting",
        "category": "GoQulient",
        "icon": "$(close)"
      },
      {
        "command": "goqulient.openTable",
        "title": "Open Table",
        "category": "GoQulient",
        "icon": "$(table)"
      },
      {
        "command": "goqulient.openErDiagram",
        "title": "Open ER Diagram",
        "category": "GoQulient",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "goqulient.copyName",
        "title": "Copy Name",
        "category": "GoQulient"
      },
      {
        "command": "goqulient.tree.activate",
        "title": "Open",
        "category": "GoQulient"
      },
      {
        "command": "goqulient.tree.enter",
        "title": "Open Selected",
        "category": "GoQulient"
      },
      {
        "command": "goqulient.showAllDatabases",
        "title": "Show All Databases",
        "category": "GoQulient"
      },
      {
        "command": "goqulient.showConnectionDatabase",
        "title": "Show Only the Connection's Database",
        "category": "GoQulient"
      }
    ],
    "configuration": {
      "title": "GoQulient",
      "properties": {
        "goqulient.connections": {
          "type": "array",
          "default": [],
          "markdownDescription": "Connections, in the same shape as the Goku app's profiles (`name`, `kind`, `hosts`, `user`, `database`, `ssl`, `ssh`, `readOnly`, …). Never put passwords here: GoQulient asks for them and keeps them in VS Code's secret storage.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind"
            ]
          }
        },
        "goqulient.envFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".env"
          ],
          "scope": "resource",
          "markdownDescription": "Files, relative to each workspace folder, searched for `DATABASE_URL`, `POSTGRES_URL`, `MYSQL_URL`, `MONGODB_URI`, `PGHOST`/`PGDATABASE`, `MYSQL_HOST`/`MYSQL_DATABASE` and similar variables. Connections found there are read-only by default, read their password from the file when connecting, and are ignored in untrusted workspaces."
        },
        "goqulient.envConnections": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "markdownDescription": "More connection URLs in the env files, e.g. `{\"url\": \"ANALYTICS_DB_URL\", \"name\": \"Analytics\", \"readOnly\": false}`. `url` is the variable's name; `file` limits the entry to one of `goqulient.envFiles`; `kind` is for URLs whose scheme doesn't say. An entry for a well-known variable such as `DATABASE_URL` overrides its name and read-only default.",
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "Name of the variable that holds the connection URL."
              },
              "name": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "description": "Only in this env file (as written in goqulient.envFiles)."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "postgres",
                  "mysql",
                  "mongodb"
                ]
              },
              "readOnly": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "goqulient.showAllDatabases": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "List every database on the server for connections that name a database. By default such a connection shows only its own database; the connection's context menu (**Show All Databases**) changes it for one connection in this workspace."
        },
        "goqulient.enginePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to a `goku-engine-server` to use instead of the bundled one (for engine development). Machine scope only, so a workspace can't point it at another program."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "goqulient",
          "title": "GoQulient",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "goqulient": [
        {
          "id": "goqulient.connections",
          "name": "Connections",
          "icon": "media/activitybar.svg",
          "contextualTitle": "GoQulient"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "goqulient.connections",
        "contents": "No database connections yet.\n[Add Connection](command:goqulient.addConnection)\n[Open Settings](command:goqulient.openSettings)\nGoQulient also reads DATABASE_URL, POSTGRES_URL, MYSQL_URL, MONGODB_URI, PG* and MYSQL_* variables from the workspace .env file (read-only by default).",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "goqulient.connections",
        "contents": "No database connections yet.\n[Add Connection](command:goqulient.addConnection)\n[Open Settings](command:goqulient.openSettings)\nThis workspace isn’t trusted, so GoQulient ignores its .env files and workspace settings. [Manage Workspace Trust](command:workbench.trust.manage)",
        "when": "!isWorkspaceTrusted"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "goqulient.addConnection",
          "when": "view == goqulient.connections",
          "group": "navigation@1"
        },
        {
          "command": "goqulient.refresh",
          "when": "view == goqulient.connections",
          "group": "navigation@2"
        },
        {
          "command": "goqulient.openSettings",
          "when": "view == goqulient.connections",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "goqulient.cancelConnecting",
          "when": "view == goqulient.connections && viewItem =~ /^goqulient\\.connection connecting\\b/",
          "group": "inline"
        },
        {
          "command": "goqulient.cancelConnecting",
          "when": "view == goqulient.connections && viewItem =~ /^goqulient\\.connection connecting\\b/",
          "group": "1_connection@1"
        },
        {
          "command": "goqulient.disconnect",
          "when": "view == goqulient.connections && viewItem =~ /^goqulient\\.connection connected\\b/",
          "group": "1_connection@2"
        },
        {
          "command": "goqulient.refreshNode",
          "when": "view == goqulient.connections && viewItem =~ /^goqulient\\.(connection (connected|failed|idle)|database|schema|group|object)\\b/",
          "group": "1_connection@3"
        },
        {
          "command": "goqulient.forgetPassword",
          "when": "view == goqulient.connections && viewItem =~ /^goqulient\\.connection .*\\bsettings\\b/",
          "group": "1_connection@4"
        },
        {
          "command": "goqulient.showAllDatabases",
          "when": "view == goqulient.connections && viewItem =~ /^goqulient\\.connection .*\\bdbfilter\\b/",
          "group": "2_databases@1"
        },
        {
          "command": "goqulient.showConnectionDatabase",
          "when": "view == goqulient.connections && viewItem =~ /^goqulient\\.connection .*\\bdball\\b/",
          "group": "2_databases@1"
        },
        {
          "command": "goqulient.openTable",
          "when": "view == goqulient.connections && viewItem == goqulient.object",
          "group": "inline"
        },
        {
          "command": "goqulient.openTable",
          "when": "view == goqulient.connections && viewItem == goqulient.object",
          "group": "0_open@1"
        },
        {
          "command": "goqulient.openErDiagram",
          "when": "view == goqulient.connections && viewItem =~ /^goqulient\\.(database|schema)$/",
          "group": "inline"
        },
        {
          "command": "goqulient.openErDiagram",
          "when": "view == goqulient.connections && viewItem =~ /^goqulient\\.(database|schema)$/",
          "group": "0_open@2"
        },
        {
          "command": "goqulient.retry",
          "when": "view == goqulient.connections && viewItem == goqulient.error",
          "group": "inline"
        },
        {
          "command": "goqulient.retry",
          "when": "view == goqulient.connections && viewItem == goqulient.error",
          "group": "1_connection@1"
        },
        {
          "command": "goqulient.copyName",
          "when": "view == goqulient.connections && viewItem =~ /^goqulient\\.(connection|database|schema|object|routine|column|error)\\b/",
          "group": "9_copy@1"
        }
      ],
      "commandPalette": [
        {
          "command": "goqulient.tree.activate",
          "when": "false"
        },
        {
          "command": "goqulient.tree.enter",
          "when": "false"
        },
        {
          "command": "goqulient.retry",
          "when": "false"
        },
        {
          "command": "goqulient.copyName",
          "when": "false"
        },
        {
          "command": "goqulient.refreshNode",
          "when": "false"
        },
        {
          "command": "goqulient.cancelConnecting",
          "when": "false"
        },
        {
          "command": "goqulient.showAllDatabases",
          "when": "false"
        },
        {
          "command": "goqulient.showConnectionDatabase",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "goqulient.tree.enter",
        "key": "enter",
        "when": "focusedView == goqulient.connections && listFocus && !inputFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node -e \"require('node:fs').copyFileSync('../LICENSE', 'LICENSE')\"",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm test",
    "e2e": "node test-e2e/run.mjs"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
