# Example environment for local development. Copy what you need; files named .env* are gitignored (except this one).
#
# 1. Try the extension against the Docker test databases (scripts/dev.sh up): copy these lines to the .env of a scratch
#    folder and open it with `scripts/dev.sh vscode run <folder>`. Test-only passwords from docker-compose.yml.
# DATABASE_URL=postgres://dbc:dbcpass@127.0.0.1:25432/shop
# MYSQL_URL=mysql://dbc:dbcpass@127.0.0.1:23306/shop?ssl-mode=REQUIRED
# MONGODB_URI=mongodb://127.0.0.1:27217/shop
#
# 2. Optional MongoDB Atlas test (engine/crates/goku-engine/tests/atlas.rs): copy these to .env.atlas, fill them in and
#    run it as docs/TESTING.md shows. Never pass the values on the command line.
GOKU_ATLAS_USER=
GOKU_ATLAS_PASSWORD=
GOKU_ATLAS_HOST=
